# Lin — AI assistant configuration (server-side only; never exposed to the browser)
#
# LOCAL:  copy this file to ".env" (same folder) and paste your key below, then run `npm start`.
# VERCEL: add the same variables in Project → Settings → Environment Variables, then redeploy.
#
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: the Claude model Lin uses (defaults to claude-sonnet-4-5).
# Change this if your account uses a different/newer model ID.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: max AI requests per visitor IP per 10 minutes (default 60).
# LIN_RATE_LIMIT=60
