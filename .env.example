# Lin — AI assistant configuration (server-side only; never exposed to the browser)
#
# STEP 1: Make a copy of this file on YOUR computer and name the copy ".env"
#         (same folder as index.html).
# STEP 2: In that .env copy, paste your key on the line marked HERE below.
# STEP 3: Run `npm start` and open http://localhost:3000
#
# ON VERCEL instead: Project → Settings → Environment Variables →
#   Name: ANTHROPIC_API_KEY   Value: your key   → then Redeploy.
#
# !! DO NOT paste your real key into THIS file on GitHub. This repository is
# !! PUBLIC, so anyone could see and use your key. Only put it in .env
# !! (which is git-ignored) or in Vercel's Environment Variables.
#
# Get a key at https://console.anthropic.com/settings/keys
#
#  ##     ##  ########  ########   ########
#  ##     ##  ##        ##     ##  ##
#  ##     ##  ##        ##     ##  ##
#  #########  ######    ########   ######
#  ##     ##  ##        ##   ##    ##
#  ##     ##  ##        ##    ##   ##
#  ##     ##  ########  ##     ##  ########
#
#  vvvvvvvvvv  PUT YOUR API KEY RIGHT AFTER THE = SIGN  vvvvvvvvvv
ANTHROPIC_API_KEY=
#  ^^^^^^^^^^  e.g.  ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx  ^^^^^^^^^^

# Optional: the Claude model Lin uses (defaults to claude-sonnet-4-5).
# Change this if your account uses a different/newer model ID.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: max AI requests per visitor IP per 10 minutes (default 60).
# LIN_RATE_LIMIT=60
